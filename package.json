{
  "name": "homethread",
  "version": "0.1.0",
  "private": true,
  "main": "apps/mobile/index.js",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "./apps/mobile/node_modules"
      ]
    }
  },
  "workspaces": [
    "apps/mobile",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "start": "npm --workspace apps/mobile run start",
    "android": "npm --workspace apps/mobile run android",
    "ios": "npm --workspace apps/mobile run ios",
    "web": "npm --workspace apps/mobile run web",
    "backend:dev": "npm --workspace apps/backend run dev",
    "backend:start": "npm --workspace apps/backend run start",
    "eas:build:development": "cd apps/mobile && eas build --platform all --profile development",
    "eas:build:preview": "cd apps/mobile && eas build --platform all --profile preview",
    "eas:build:production": "cd apps/mobile && eas build --platform all --profile production",
    "eas:submit:production": "cd apps/mobile && eas submit --platform all --profile production",
    "db:generate": "npm --workspace apps/backend run db:generate",
    "db:migrate": "npm --workspace apps/backend run db:migrate",
    "test": "npm --workspace apps/backend run test && npm --workspace apps/mobile run test",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "dependencies": {
    "expo": "56.0.13",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "esbuild": "0.25.12",
    "expo": "56.0.13",
    "@expo/cli": "56.1.17",
    "@expo/dom-webview": "56.0.6",
    "@expo/fingerprint": "0.19.5",
    "@expo/log-box": "56.0.14",
    "@expo/metro-config": "56.0.15",
    "@expo/metro-runtime": "56.0.16",
    "@sentry/react-native": "7.11.0",
    "babel-preset-expo": "56.0.16",
    "expo-asset": "56.0.18",
    "expo-constants": "56.0.19",
    "expo-file-system": "56.0.8",
    "expo-font": "56.0.7",
    "expo-image-picker": "56.0.19",
    "expo-keep-awake": "56.0.3",
    "expo-modules-autolinking": "56.0.17",
    "expo-modules-core": "56.0.18",
    "expo-modules-jsi": "56.0.10",
    "expo-notifications": "56.0.19",
    "expo-splash-screen": "56.0.11"
  }
}
