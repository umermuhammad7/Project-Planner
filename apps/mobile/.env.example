# API (required for household sync)
# For physical devices, preview builds, and production builds, point this at a reachable host instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Supabase auth (required for production sign-in; optional for local dev token)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Local dev token path (backend must allow DEV_AUTH_TOKEN)
EXPO_PUBLIC_DEV_AUTH_TOKEN=homethread-dev-token

# EAS / Expo push (required on a physical device to register an Expo push token)
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id

# RevenueCat (optional until store billing is configured)
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Note: native home-screen widgets are not shipped in this repo yet.
# widgetSnapshot.ts only stores a JSON snapshot after sync (web/localStorage).
