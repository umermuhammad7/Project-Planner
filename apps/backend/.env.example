DATABASE_URL=postgresql://postgres:your_password@localhost:5432/HomeThread
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8081,http://localhost:19006,exp://homethread,homethread://auth/callback
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=homethread-dev-token

# Assistant (optional - without these, mobile falls back to text parsing only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Calendar OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/calendar-sync/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Background jobs / notifications
# JOBS_ENABLED must be true on the deployed backend (e.g. Railway) for reminders/digests
# to actually queue and send. Setting it in this repo file only affects local dev — on
# Railway it must be set directly as a project Variable, since Railway does not read
# committed env files.
JOBS_ENABLED=true
# Personal access token from https://expo.dev/accounts/<your-account>/settings/access-tokens
# Required for Expo to accept push sends once your project enforces enhanced push security.
EXPO_PUSH_ACCESS_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com

# Maps / travel reminders (optional)
GOOGLE_MAPS_API_KEY=
TRAVEL_HOME_LATITUDE=
TRAVEL_HOME_LONGITUDE=

# Store billing webhook (optional until paid plans are live)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=family_plus

# =============================================================================
# TestFlight backend checklist
# 1. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set on Railway/host
# 2. NODE_ENV=production disables dev-token auth
# 3. DEV_AUTH_ENABLED only for local development, never on shared/staging hosts
# 4. At least one AI key for cloud assistant QA
# 5. REVENUECAT_WEBHOOK_SECRET when testing paid plan sync
# =============================================================================
