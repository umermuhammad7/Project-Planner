{
  "expo": {
    "name": "HomeThread",
    "slug": "homethread",
    "scheme": "homethread",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./apps/mobile/assets/icon.png",
    "splash": {
      "image": "./apps/mobile/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EE"
    },
    "description": "Family household planner. EAS builds are configured; store submission and push delivery require external setup.",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homethread.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homethread.app",
      "adaptiveIcon": {
        "foregroundImage": "./apps/mobile/assets/icon.png",
        "backgroundColor": "#F7F4EF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "c0560be0-2c73-43bc-81ad-aa85cd2e7091"
      }
    },
    "owner": "umaf"
  }
}
