# =============================================================================
# HomeThread mobile — environment template
# Copy to apps/mobile/.env for local dev, or set in eas.json build profiles for TestFlight.
# =============================================================================

# API (required for household sync on real devices)
# Local dev:
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
# TestFlight / preview builds should use your deployed API, e.g.:
# EXPO_PUBLIC_API_URL=https://your-backend.example.com/api/v1

# Supabase auth (required for TestFlight account sign-in)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_SUPABASE_AVATAR_BUCKET=avatars
# Supabase Auth redirect URLs must include:
# - homethread://auth/callback
# - your Expo web URL if testing browser sign-in
# Profile photos need the avatars bucket with signed-in upload access.

# Local dev token path (backend must set DEV_AUTH_ENABLED=true; disabled in production)
EXPO_PUBLIC_DEV_AUTH_TOKEN=homethread-dev-token

# EAS / Expo push (required on a physical device to register a push token)
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id

# RevenueCat public SDK keys (optional until store billing QA)
# Set EXPO_PUBLIC_REVENUECAT_IOS_API_KEY in the preview/production EAS profile for TestFlight billing tests.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY=

# =============================================================================
# TestFlight QA checklist (configure outside the app UI)
# 1. EXPO_PUBLIC_API_URL points at a reachable production/staging API
# 2. Supabase URL + anon key are embedded in the EAS preview profile
# 3. Supabase redirect URL includes homethread://auth/callback
# 4. Backend has SUPABASE_SERVICE_ROLE_KEY + DATABASE_URL on Railway/host
# 5. Backend AI: OPENAI_API_KEY and/or GROQ_API_KEY_1 for cloud assistant
# 6. EXPO_PUBLIC_EAS_PROJECT_ID set for push token registration tests
# 7. EXPO_PUBLIC_REVENUECAT_IOS_API_KEY + App Store products for billing tests
# 8. In app: Settings → Test build status shows what is actually ready
# =============================================================================

# Note: native home-screen widgets are not shipped in this repo yet.
